	partition dCalendar = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFolder & "production_planning.xlsx"), null, true),
				    Sheet = Source{[Item="dCalendar",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"week_start", type date}, {"week_start_number", Int64.Type}, {"week_label", type text}, {"year_month_number", Int64.Type}, {"month_label", type text}, {"horizon", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
